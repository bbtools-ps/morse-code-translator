{
  "name": "morse-code-translator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.11.9",
    "@mui/material": "^5.11.10",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "prebuild": "tsc -b && vp test run",
    "preview": "vp preview",
    "test": "vp test --reporter=verbose",
    "format": "vp fmt '**/*.{js,ts,tsx,jsx}'",
    "lint": "vp lint src",
    "fix": "vp lint --fix src",
    "typecheck": "tsc -b",
    "preinstall": "npx only-allow pnpm",
    "prepare": "vp config --no-agent"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.4.0",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^21.1.0",
    "lint-staged": "^16.2.6",
    "typescript": "^5.5.3",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
